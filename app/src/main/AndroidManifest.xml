<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The blur library is called only on API 33+; API 31/32 use RenderEffect fallback. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Arashi">
        <activity android:name=".tools.ZybosEnvController" android:exported="false" />
        <activity android:name=".tools.QuickCommands" android:exported="false" />
        <activity android:name=".settings.HookSettings" android:exported="false" />
        <activity android:name=".settings.BackgroundWhitelistActivity" android:exported="false" />
        <activity android:name=".uninstall.UninstallSettings" android:exported="false" />
        <activity android:name=".tcp.TcpHistoryActivity" android:exported="false" />
        <activity android:name=".uninstall.UninstallHistoryActivity" android:exported="false" />
        <activity android:name=".uninstall.UninstallListActivity" android:exported="false" />
        <activity android:name=".UninstallPromptActivity"
            android:theme="@style/Theme.Arashi.Prompt"
            android:exported="true"
            android:permission="android.permission.DELETE_PACKAGES"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden"
            android:finishOnTaskLaunch="true" />
        <activity android:name=".Main" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".LauncherAlias"
            android:targetActivity=".Main"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".xposed.SettingsProvider"
            android:authorities="com.lijinmu.arashi.settings"
            android:exported="true"
            android:multiprocess="false" />
    </application>
</manifest>
