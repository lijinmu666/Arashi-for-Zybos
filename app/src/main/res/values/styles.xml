<resources>
    <style name="Theme.Arashi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F7F7</item>
        <item name="android:navigationBarColor">#F7F7F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7655D9</item>
    </style>

    <style name="Theme.Arashi.Installer" parent="@style/Theme.Arashi">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#F7F7F7</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Theme.Arashi.Prompt" parent="@style/Theme.Arashi">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>
